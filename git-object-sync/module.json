  "compatibility": {
    "minimum": "12",
    "verified": "12",
    "maximum": "12"
  },
  "authors": [
    {
      "name": "Dominik Gursch"
    }
  ],
  "license": "MIT",
  "url": "https://github.com/DominikGursch/foundryvtt-git-sync",
  "esmodules": [
    "scripts/main.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ],
  "flags": {}
}
